# Neon: pooled for the app, direct for migrations
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/afrolit?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.neon.tech/afrolit?sslmode=require"

AUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

RESEND_API_KEY=""
RESEND_FROM="AfroLit Playlist <hello@afrolitplaylist.com>"

CRON_SECRET="generate with: openssl rand -hex 24"

# In-process database ping. Runs every 15 minutes while the Node server is up.
# Set to false to stop it. DB_KEEP_ALIVE_INTERVAL_MS overrides the interval.
# DB_KEEP_ALIVE=true

# Shared rate limiting. Without these, limits fall back to per-instance memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
